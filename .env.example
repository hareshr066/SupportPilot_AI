GITHUB_TOKEN=your_github_pat_here
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/database_name
GITHUB_MAX_ISSUES=1000
GITHUB_MAX_COMMENTS_PER_ISSUE=50
LOG_LEVEL=INFO
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
DUPLICATE_TOP_K=20
DUPLICATE_THRESHOLD=0.5
EMBEDDING_BATCH_SIZE=32
SEVERITY_MODEL_NAME=distilbert-base-uncased
SEVERITY_MAX_LENGTH=256
SEVERITY_BATCH_SIZE=16
SEVERITY_LEARNING_RATE=2e-5
SEVERITY_EPOCHS=3
SEVERITY_RANDOM_SEED=42
SEVERITY_MODEL_PATH=./models/severity/v1
ROOT_CAUSE_ISSUE_STATE=closed
ROOT_CAUSE_MIN_TEXT_LENGTH=10
ROOT_CAUSE_UMAP_NEIGHBORS=15
ROOT_CAUSE_UMAP_COMPONENTS=10
ROOT_CAUSE_UMAP_MIN_DIST=0.1
ROOT_CAUSE_UMAP_METRIC=cosine
ROOT_CAUSE_UMAP_RANDOM_STATE=42
ROOT_CAUSE_HDBSCAN_MIN_CLUSTER_SIZE=15
ROOT_CAUSE_HDBSCAN_MIN_SAMPLES=5
ROOT_CAUSE_MAX_REPRESENTATIVE_ISSUES=5
ROOT_CAUSE_LLM_MODEL=gpt-4o-mini
