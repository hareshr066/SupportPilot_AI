# =====================================================================
# SUPPORTPILOT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure for your environment.
# NEVER commit actual secret credentials or API keys to source control.
# =====================================================================

# --- Application Environment ---
# Options: 'development' (allows local SQLite fallback) | 'production' (strictly enforces PostgreSQL)
APP_ENV=production

# --- Database Configuration ---
# Production requires a valid PostgreSQL URL (with psycopg 3 driver)
# Example: postgresql+psycopg://username:password@localhost:5432/support_triage
# Development local fallback: sqlite:///./data/support_triage.db
DATABASE_URL=postgresql+psycopg://postgres:postgres123@localhost:5432/support_triage

# --- Server-to-Server Service Authentication ---
# Server-side API key for external service-to-service integration (e.g. StudySync)
SUPPORTPILOT_API_KEY=your_supportpilot_api_key_here

# --- External AI & LLM Services ---
# OpenAI API Key for Grounded Resolution and Claim Verification
# Note: The system features robust local fallbacks and calibration guards if quota is unavailable.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
RESOLUTION_LLM_MODEL=gpt-4o-mini
VERIFIER_LLM_MODEL=gpt-4o-mini
ROOT_CAUSE_LLM_MODEL=gpt-4o-mini

# --- GitHub Integration ---
# GitHub Personal Access Token (PAT) for authenticated REST API calls (increases rate limit from 60 to 5,000 req/hr)
# Optional: If omitted, the application operates in unauthenticated mode.
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_key_here

# --- Data Ingestion & Scaling ---
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
GITHUB_MAX_ISSUES=1000
GITHUB_MAX_COMMENTS_PER_ISSUE=50
LOG_LEVEL=INFO

# --- Local ML & Neural Models ---
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
DUPLICATE_TOP_K=20
DUPLICATE_THRESHOLD=0.5
EMBEDDING_BATCH_SIZE=32

SEVERITY_MODEL_NAME=distilbert-base-uncased
SEVERITY_MAX_LENGTH=256
SEVERITY_BATCH_SIZE=16
SEVERITY_LEARNING_RATE=2e-5
SEVERITY_EPOCHS=3
SEVERITY_RANDOM_SEED=42
SEVERITY_MODEL_PATH=./models/severity/v1

# --- Root-Cause Discovery (Clustering) ---
ROOT_CAUSE_ISSUE_STATE=closed
ROOT_CAUSE_MIN_TEXT_LENGTH=10
ROOT_CAUSE_UMAP_NEIGHBORS=15
ROOT_CAUSE_UMAP_COMPONENTS=10
ROOT_CAUSE_UMAP_MIN_DIST=0.1
ROOT_CAUSE_UMAP_METRIC=cosine
ROOT_CAUSE_UMAP_RANDOM_STATE=42
ROOT_CAUSE_HDBSCAN_MIN_CLUSTER_SIZE=15
ROOT_CAUSE_HDBSCAN_MIN_SAMPLES=5
ROOT_CAUSE_MAX_REPRESENTATIVE_ISSUES=5

# --- Hybrid Retrieval & RRF ---
RETRIEVAL_DENSE_TOP_K=50
RETRIEVAL_BM25_TOP_K=50
RETRIEVAL_FINAL_TOP_K=10
RETRIEVAL_RRF_K=60
RETRIEVAL_DENSE_WEIGHT=0.6
RETRIEVAL_BM25_WEIGHT=0.4
RETRIEVAL_REPOSITORY_SCOPE=same_repository
RETRIEVAL_BM25_INDEX_DIR=./data/retrieval_index
RETRIEVAL_ALPHA_EVIDENCE=0.3

# --- Calibration & Routing Policies ---
CONFIDENCE_DEFAULT_THRESHOLD=0.85
CONFIDENCE_MAX_FALSE_AUTO_RESOLUTION_RATE=0.02
ROUTING_MIN_CONFIDENCE=0.60
ROUTING_DEFAULT_QUEUE=GENERAL_SUPPORT_QUEUE
